# ============================================================================
# NovaLearn environment configuration
#
# HOW TO USE
#   1. Copy this file to `.env` in the same directory:   cp .env.example .env
#   2. Fill in real values (see each section below).
#   3. Start the app:  ./mvnw spring-boot:run   (or the built jar)
#
# Spring Boot loads `.env` automatically at startup via
#   spring.config.import=optional:file:.env[.properties]
# in application.properties — no extra tooling needed.
#
# NEVER commit the real `.env` to git. It holds secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL database  (REQUIRED — the app will not start without it)
#
# Local dev quick start:
#   createdb novalearn
#   ...then point DB_URL at localhost and set your local role/password.
#
# On Render/Railway: use the connection string their dashboard provides
# (sslmode may be required, e.g.
#   jdbc:postgresql://host:5432/novalearn?sslmode=require )
# ----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/novalearn
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ----------------------------------------------------------------------------
# Email / SMTP via Gmail  (required ONLY for the "Forgot Password" flow)
#
# Reset codes are 6-digit codes mailed to the user through Gmail SMTP.
# Setup:
#   1. Enable 2-Step Verification on the sending Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Put that 16-character app password in MAIL_PASSWORD
#      (NOT the normal Google account password).
#
# Without these values: registration, login and courses all still work;
# only password-reset emails fail.
# ----------------------------------------------------------------------------
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ----------------------------------------------------------------------------
# Cloudinary  (REQUIRED for video / PDF / image uploads)
#
# Course videos, PDFs and images are stored on Cloudinary and played back
# from its CDN. Lecturers upload them on "Create Course" and "Create Session".
#
# Without these values: creating a VIDEO course or posting an attachment
# fails with the error banner "Cloudinary credentials are not configured...".
# All non-upload features keep working.
#
# Setup:
#   1. Create a free account at https://cloudinary.com
#   2. Dashboard -> Settings -> API Keys -> copy the three values below.
#
# Notes:
#   - The free tier caps a single video upload at ~100 MB; the app accepts
#     up to 1 GB per file, so larger files need a paid plan.
#   - Supported types: .mp4 .webm .ogg .pdf .jpg .jpeg .png
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ----------------------------------------------------------------------------
# Optional overrides (safe to delete; application.properties has defaults)
#
# DDL_AUTO      Hibernate schema mode: update | validate | none.
#               "update" is right for dev/testing; use "validate" in prod
#               once the schema is stable. (Render's render.yaml sets update.)
#
# THYMELEAF_CACHE  Set to false while developing so template edits show
#               without a rebuild. Keep true (default) in production.
#
# management.health.mail.enabled  With empty MAIL_* credentials the
#               /actuator/health mail check reports DOWN. For LOCAL testing
#               only, uncomment the next line to disable just that check
#               (database health is still checked). Leave it enabled in prod.
# ----------------------------------------------------------------------------
# DDL_AUTO=update
# THYMELEAF_CACHE=false
# management.health.mail.enabled=false
